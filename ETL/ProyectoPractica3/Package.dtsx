                  description="Especifica la instrucción SQL utilizada por el componente para extraer datos."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    p.CLAVE_PART AS nk_clave_part,
    p.NOM,
    p.AP_PAT,
    p.AP_MAT,
    p.INST,
    p.TIPO_PART,
    p.NACIONALIDAD,
    p.DIR,
    CASE
        WHEN p.TIPO_PART = 'E' THEN 'ING'
        WHEN p.TIPO_PART = 'P' THEN 'MC'
        ELSE 'LIC'
    END AS grado
FROM PARTICIPANTE p;</property>
